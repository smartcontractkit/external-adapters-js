# TEMP, one-off Dockerfile for the coinmetrics-bun-grpc-poc test build only - not for upstream.
# Delete this file once the test image has served its purpose.
#
# Same as the shared root Dockerfile's native-gRPC PoC pattern (see coinpaprika/coinmetrics commits
# on this branch), except coinmetrics' local-framework tarball on this commit is built from
# ea-framework-js's `bun-grpc` branch, which replaces fastify/ioredis/ws/axios with Bun-native
# equivalents (Bun.serve, Bun.redis, native WebSocket/fetch). Those are runtime globals that only
# exist under the `bun` binary, not `node` - so unlike the shared Dockerfile, the FINAL stage here
# must run on a Bun base image, not node:22-alpine. The builder stage stays on node:22 since it only
# compiles/bundles coinmetrics' own TypeScript (tsc, ncc) and never executes the framework bundle.
FROM node:22 as builder
ARG location
ARG package
WORKDIR /home/node/app
COPY . .
RUN yarn workspaces focus $package @chainlink/external-adapters-js @chainlink/ea-test-helpers @chainlink/ea-reference-data-reader @chainlink/ea-factories @chainlink/ea-scripts
RUN yarn workspace $package build
RUN yarn generate:endpoint-aliases
RUN yarn bundle $location -o $location/bundle

# TEMP local-only patch (same as coinpaprika-native-grpc-poc branch): ncc's bundler doesn't carry
# along non-JS assets, so streams.proto/health.proto have to be placed next to the bundled index.js
# by hand. Not for upstream - remove before this branch is ever used for anything real.
RUN cp $location/local-framework/streams.proto $location/local-framework/health.proto $location/bundle/

FROM oven/bun:alpine
ARG location
ARG package
ENV PACKAGE_NAME=$package

EXPOSE 8080
WORKDIR /home/node/app

COPY --from=builder /home/node/app/$location/bundle ./
# Wildcards are included to handle cases where this file doesnt exist
COPY --from=builder /home/node/app/$location/package.json /home/node/app/$location/*test-payload.js* ./

# oven/bun:alpine's default user is already non-root ("bun"); no separate chown/USER step needed
# the way the node:22-alpine final stage does for the "node" user.

# Bypass `yarn server` (node -e '...') entirely: a plain bun:alpine image has no yarn/node binary,
# and the bundle needs to run under `bun` specifically for its native Bun.serve/Bun.redis calls to
# resolve. Mirrors packages/sources/coinmetrics/package.json's own "server" script 1:1, just via bun.
CMD ["bun", "-e", "require('./index.js').server()"]
